        <commons.csv.version>1.11.0</commons.csv.version>
        <duckdb.version>1.1.3</duckdb.version>
        <qlexpress.version>4.0.4</qlexpress.version>
        <spring.batch.version>4.3.10</spring.batch.version>
        <springdoc.version>1.8.0</springdoc.version>
        <fesod.sheet.version>2.1.0-SNAPSHOT</fesod.sheet.version>
        <mysql.connector.version>8.0.33</mysql.connector.version>
        <jsch.version>0.2.26</jsch.version>
        <jcraft.jsch.version>0.1.55</jcraft.jsch.version>
        <aws.java.sdk.s3.version>1.12.450</aws.java.sdk.s3.version>
        <db.scheduler.version>15.6.0</db.scheduler.version>
        <javax.persistence.version>2.2</javax.persistence.version>
        <mybatis.spring.boot.starter.test.version>2.3.2</mybatis.spring.boot.starter.test.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <postgresql.version>42.7.8</postgresql.version>
        <oracle.jdbc.version>23.26.2.0.0</oracle.jdbc.version>
        <jqwik.version>1.9.2</jqwik.version>
        <lombok.version>1.18.34</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.yss.cloud</groupId>
