            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-transfer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-extract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-taskflow-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-taskflow-springbatch</artifactId>
