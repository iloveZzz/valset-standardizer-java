            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-taskflow-dolohinscheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yss.datamiddle</groupId>
                <artifactId>valset-standardizer-taskflow-xxljob</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yss.cloud</groupId>
                <artifactId>yss-components-bom</artifactId>
                <version>${yss-datamiddle.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.yss.filesys</groupId>
                <artifactId>yss-filesys-feignsdk</artifactId>
                <version>${yss.filesys.feignsdk.version}</version>
