    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>valset-feature.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>valset-feature.properties</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>smart-doc-maven-plugin</artifactId>
                <configuration>
                    <configFile>src/main/resources/smart-doc.json</configFile>
                    <includes>
                        <!-- 如果配置了includes的情况下， 使用了jpa的分页需要include所使用的源码包 -->
                        <include>com.yss.cloud:yss-component-dto</include>
                        <include>com.yss.datamiddle:datamiddle-component-exception</include>
                        <include>com.yss.datamiddle:datamiddle-component-cache-starter</include>
                        <include>com.yss.cloud:yss-component-dir-client</include>
                        <include>com.yss.cloud:yss-component-dir</include>
                        <include>com.yss.cloud:yss-component-dir-common</include>
                        <include>com.yss.datamiddle:valset-standardizer-api</include>
                        <include>com.yss.datamiddle:valset-standardizer-extract</include>
                        <include>com.yss.datamiddle:valset-standardizer-knowledge</include>
                        <include>com.yss.datamiddle:valset-standardizer-parser</include>
                        <include>com.yss.datamiddle:valset-standardizer-knowledge</include>
                        <include>com.yss.datamiddle:valset-standardizer-transfer</include>
                        <include>com.yss.datamiddle:valset-standardizer-task</include>
                        <include>com.yss.datamiddle:valset-standardizer-batch</include>
                        <include>com.yss.datamiddle:valset-standardizer-taskflow-adapter</include>
                        <include>com.yss.datamiddle:valset-standardizer-taskflow-springbatch</include>
                        <include>com.yss.datamiddle:valset-standardizer-taskflow-dolohinscheduler</include>
                        <include>com.yss.datamiddle:valset-standardizer-taskflow-xxljob</include>
                    </includes>
                    <projectName>${project.description}</projectName>
                </configuration>
                <groupId>com.github.shalousun</groupId>
                <version>yss-4.0.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>parser</id>
            <properties>
                <valset.features.parse-lifecycle.enabled>true</valset.features.parse-lifecycle.enabled>
                <valset.features.parse-queue-observer.enabled>false</valset.features.parse-queue-observer.enabled>
            </properties>
        </profile>
        <profile>
            <id>workflow</id>
            <properties>
                <valset.features.parse-lifecycle.enabled>false</valset.features.parse-lifecycle.enabled>
                <valset.features.parse-queue-observer.enabled>true</valset.features.parse-queue-observer.enabled>
            </properties>
        </profile>
        <profile>
            <id>full</id>
            <properties>
                <valset.features.parse-lifecycle.enabled>true</valset.features.parse-lifecycle.enabled>
                <valset.features.parse-queue-observer.enabled>true</valset.features.parse-queue-observer.enabled>
            </properties>
        </profile>
    </profiles>
</project>
